{
  "name": "opencadkid",
  "version": "1.5.2",
  "private": true,
  "description": "Gentle touch-first educational games for young children.",
  "license": "MIT",
  "author": "David Sevin",
  "homepage": "https://davy45270.github.io/opencadkid/",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:precache": "node scripts/check-precache.js",
    "test:impact": "node --test scripts/test-e2e-impact.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --max-warnings=0",
    "test": "vitest run --pool=threads --maxWorkers=2",
    "test:e2e": "playwright test"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
