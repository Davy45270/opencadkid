{
  "name": "opencadkid",
  "version": "1.0.1",
  "private": true,
  "description": "Gentle touch-first educational games for young children.",
  "license": "MIT",
  "author": "David Sevin",
  "homepage": "https://davy45270.github.io/opencadkid/",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:precache": "node scripts/check-precache.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --pool=threads --maxWorkers=2",
    "test:e2e": "playwright test"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
